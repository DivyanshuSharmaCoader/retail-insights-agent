# Copy to .env and fill in ONE provider. Never commit .env.

# --- OpenAI (default) ---
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# --- or Google Gemini (pip install -e ".[gemini]") ---
# LLM_PROVIDER=gemini
# GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Embeddings: "local" needs no key (hashing trick); "openai" / "gemini" give semantic search.
EMBEDDING_PROVIDER=local

# Optional: shared answer cache. Without it, an in-process cache is used.
# REDIS_URL=redis://localhost:6379/0

# Optional: Postgres instead of the bundled SQLite file.
# DATABASE_URL=postgresql+psycopg://retail:retail@localhost:5432/retail
